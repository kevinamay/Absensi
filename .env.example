# ==============================================================================
# CLIENT-SIDE FIREBASE CONFIGURATION (Publicly accessible in client bundle)
# Get these from Firebase Console > Project Settings > General > Web Apps
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="cv-asia-plastik-attendance.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="cv-asia-plastik-attendance"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="cv-asia-plastik-attendance.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==============================================================================
# SERVER-SIDE FIREBASE ADMIN SDK CONFIGURATION (Keep Secret - Never expose to client)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ==============================================================================
FIREBASE_PROJECT_ID="cv-asia-plastik-attendance"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@cv-asia-plastik-attendance.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# CV. ASIA PLASTIK FACTORY / OFFICE GEOFENCING CONFIGURATION
# Default Coordinates & Radius (in meters) for Intern Attendance Validation
# ==============================================================================
NEXT_PUBLIC_OFFICE_LATITUDE="-7.424312"
NEXT_PUBLIC_OFFICE_LONGITUDE="112.721415"
NEXT_PUBLIC_OFFICE_RADIUS_METERS="100"
NEXT_PUBLIC_COMPANY_NAME="CV. Asia Plastik"
